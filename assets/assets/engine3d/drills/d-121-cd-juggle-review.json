 "narration": [
  {
   "t": 0,
   "text": "The review is the product. The juggling keeps hands and eyes busy enough for honesty.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 6.25,
   "text": "Relaxed juggling together, any surface, catches allowed.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 13,
   "text": "Between records you ask. What worked today, what was hard, what next week.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 18,
   "text": "Their answers write next session's first drill. End on a caught ball and a handshake.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 21,
   "text": "If they're older, they set one measurable target out loud. If they're little, keep the questions tiny.",
   "hold": 2.5,
   "beat": "take"
  }
 ]
