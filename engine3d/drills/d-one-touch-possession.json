 "narration": [
  {
   "t": 0,
   "text": "Six against two, in a fifteen metre grid, and one touch only.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "It's tight on purpose, so there's no touch to fix a bad position.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 4.73,
   "text": "Receivers have to move before the ball arrives, or the pass isn't on.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 14.2,
   "text": "Watch the shift into space just before it lands. That's the habit.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 19.72,
   "text": "Ninety second rounds. Once they cope, shrink the grid by two metres each round.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 22.22,
   "text": "It's messy first time, and it shows you every bad angle in your team.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
}
