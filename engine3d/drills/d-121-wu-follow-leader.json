   "text": "A big area, a ball each, and nowhere in particular to go.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 4.6,
   "text": "Every stop, turn and skip you make echoes down the line behind you.",
   "hold": 2.5,
   "beat": "action"
  },
  {
