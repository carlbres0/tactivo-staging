  },
  {
   "t": 5.04,
   "text": "The team without it all press. Nobody gets to rest in cover.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 15.11,
   "text": "Eight passes is a point, and losing it resets the count to nothing.",
   "hold": 2.5,
   "beat": "action"
  },
