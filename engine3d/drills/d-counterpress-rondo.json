 "narration": [
  {
   "t": 0,
   "text": "Nobody gets a rest in this one, and they'll feel it within a minute.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "An eighteen by eighteen grid, two teams of four, one keeping and one pressing.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 1,
   "text": "Four consecutive passes scores, and the press is trying to stop the first one.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 8.5,
   "text": "When it turns over the roles swap instantly. No reset, no restart, keep moving.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 14.66,
   "text": "Two minute rounds, a minute walking between. Shrink the grid so the press arrives faster.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 17.16,
   "text": "If a player is standing after a turnover, they're the reason the pass got through.",
