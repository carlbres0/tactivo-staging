 "narration": [
  {
   "t": 0,
   "text": "Ladders are the excuse. The reaction is the warm-up.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 7,
   "text": "Quick feet through the ladder. One pattern a round. Single step, lateral, in in out.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 11.75,
   "text": "As the last rung is hit, you call a colour. Sprint through that cone, jog back.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 17.75,
   "text": "Last two rounds, the sprint ends on a rolling ball and they dribble clear.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 23.5,
   "text": "Too easy, call late, or call one colour and point at another. Too hard, walk it, no call.",
   "hold": 2.5,
   "beat": "take"
