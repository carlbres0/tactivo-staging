 "narration": [
  {
   "t": 0,
   "text": "How do you know if a player actually looked? Make them tell you.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "One player works in the middle of a fifteen metre grid, four servers around it.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 1,
   "text": "As the pass travels, you raise a coloured cone somewhere behind them.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 4.42,
   "text": "They turn out, name the colour out loud, and pass to that server.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 6.31,
   "text": "Forty five seconds each, then rotate. Later, raise two colours and they name both.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 8.81,
   "text": "They can't name what they didn't check, so the scan has to happen early.",
