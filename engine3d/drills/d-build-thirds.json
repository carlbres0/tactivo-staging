   "t": 0,
   "text": "When a press arrives, going long is the easy answer. This one takes it away.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "A forty by thirty pitch split into three thirds, keeper and defenders in the first.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 3.25,
   "text": "The ball has to touch every third, and playing back to restart is always allowed.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 9.75,
   "text": "Centre-backs split wide, and the midfielder drops between them the moment the press comes.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 12.5,
   "text": "Defenders press in their own third only. Let one follow the ball through to make it live.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 15,
   "text": "Play the way the press shows you. Jump the centre-back and the midfielder is free.",
   "hold": 2.5,
   "beat": "why"
