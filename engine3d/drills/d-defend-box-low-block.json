 "narration": [
  {
   "t": 0,
   "text": "Some weeks you'll be camped in your own box. This rehearses that honestly.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Six defenders sit deep against eight attackers circulating around the box.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 1.37,
   "text": "The attackers probe, and nobody presses out. The shape just holds.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 5.01,
   "text": "The block refuses to be dragged apart, and forces a shot from distance.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 9.1,
   "text": "Once they hold it, drop to five defenders and make it harder.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 11.6,
   "text": "Every team spends some Saturdays doing this. Pretending otherwise doesn't make it go away.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
