 "narration": [
  {
   "t": 0,
   "text": "This one gets honest answers out of a player, because their feet are busy.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Anywhere soft, two of you juggling gently, catches allowed.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 6.23,
   "text": "Between records, ask what worked today, what was hard, and what comes next week.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 17.85,
   "text": "Their answers write the first drill of your next session.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 20.75,
   "text": "Once they are talking, ask for one measurable target, said out loud.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 23.25,
   "text": "End on a caught ball and a handshake. The review is the product here.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
