 "narration": [
  {
   "t": 0,
   "text": "Make the whole end line the goal, and players stop piling into the middle.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Even teams, both end lines coned, and no goals to aim at.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 3.68,
   "text": "Score by stopping the ball dead on the opposition end line.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 11.78,
   "text": "After a score, the scoring team turns and attacks the other way immediately.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 14.72,
   "text": "Once they're finding the space, a stop in the final metre after a take-on counts double.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 17.22,
   "text": "Praise the player who carries away from the crowd. The wide space is the lesson.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
