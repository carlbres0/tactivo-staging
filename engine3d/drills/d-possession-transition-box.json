 "narration": [
  {
   "t": 0,
   "text": "Two boxes side by side, and only the ball and the defenders ever move.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Five keep it against two in one box, while five more rest in the other.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 4.64,
   "text": "The two defenders win it, and that turnover is what the whole drill is built on.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 11.79,
   "text": "They carry it into the far box, and the resting five become the possession five.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 17.86,
   "text": "Swap the pair every two minutes, then try three defenders so turnovers come faster.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 20.36,
   "text": "The two seconds after a turnover decide the next minute, and this makes that visible.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
}
