   "beat": "picture"
  },
  {
   "t": 3.73,
   "text": "The press shows the ball wide on purpose, then swarms it against the line.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 8.71,
   "text": "Everyone presses from the inside out. Nobody comes from outside in, ever.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 12.45,
   "text": "Swap every four minutes, then make only wins inside the trap zone count.",
