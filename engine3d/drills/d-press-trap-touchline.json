  {
   "t": 0,
   "text": "Ever noticed the touchline does more defending than your winger? Use it properly.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Both touchlines are marked as traps, in a forty by thirty area.",
