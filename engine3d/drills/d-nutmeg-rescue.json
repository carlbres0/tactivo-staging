 "narration": [
  {
   "t": 0,
   "text": "Passing games at this age can be dull. Tag with a rescue never is.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Two catchers, everybody else dribbling a ball around a twenty metre square.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 4.14,
   "text": "Tagged? Freeze, hold your ball above your head, feet wide apart.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 11.78,
   "text": "A free player rescues you with a pass through your legs, and you are back.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 15.92,
   "text": "Later the rescue pass has to come from three big steps away.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 18.42,
   "text": "Rescues are the score, not tags, so the pass under pressure is the drill.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
