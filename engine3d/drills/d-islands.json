 "narration": [
  {
   "t": 0,
   "text": "This one has them scanning while they dribble, and it feels like a game.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Five little cone islands inside a big sea, everybody dribbling around them.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 2.55,
   "text": "Call storm and they dribble onto an island, but each one only holds three.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 10.95,
   "text": "Full island? Sail on and find another before the count of ten.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 12.73,
   "text": "Take an island away each round so the last ones just get busier.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
