 "narration": [
  {
   "t": 0,
   "text": "This one calms them down without a single static stretch. They'll think it's a game.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "A circle of players three metres apart, one ball, keeping it off the floor.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 5.49,
   "text": "Any surface but hands. First touch to a neighbour keeps it alive, so call it early.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 23.35,
   "text": "The ball works its way round the circle while you count the team record.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 27.47,
   "text": "Older groups can add a second ball. Finish with a walking lap and calf stretches.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 29.97,
   "text": "A calm finish that still feels like football, so it goes down better than stretching alone.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
