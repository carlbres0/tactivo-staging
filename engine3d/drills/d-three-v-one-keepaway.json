 "narration": [
  {
   "t": 0,
   "text": "Need a rondo the little ones can actually manage? Three against one.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "A small grid, three keeping the ball, and one chasing it in the middle.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 1.64,
   "text": "The two off the ball always offer two different angles. That's the whole drill.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 14.78,
   "text": "Five passes in a row is a point, and they count it out loud.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 20.53,
   "text": "Once they're comfortable, two touches only for the three in possession.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 23.03,
   "text": "Give it away and you're the defender, so nobody hides from a loose pass.",
