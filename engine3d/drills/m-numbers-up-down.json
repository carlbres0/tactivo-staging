 "narration": [
  {
   "t": 0,
   "text": "Both sides learn something. One about patience, one about protecting a lead with less.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 3.75,
   "text": "Play starts even. Every two minutes you take a player off one team.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 9.5,
   "text": "The short team adapts. Compact, counter, and use the ball well when they get it.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 14.25,
   "text": "The player taken off jogs the outside and feeds the next ball in. Then swap sides.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 19,
   "text": "Too easy, two players off at once. Too hard, one off for a minute at a time.",
   "hold": 2.5,
   "beat": "take"
  }
 ]
