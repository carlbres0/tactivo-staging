 "narration": [
  {
   "t": 0,
   "text": "Pairs, four metres apart, one ball between two. All you need for a block tackle.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Set the shape first. Knee bent, ankle locked, opposite arm out for balance.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 1.53,
   "text": "On your call, both step in and meet the ball with a firm block.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 8.76,
   "text": "Push through it, no swing, weight over the ball. Five controlled reps each.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 10.95,
   "text": "Raise the approach speed a notch each round. Last round, the carrier dribbles in slowly.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 13.45,
   "text": "A block is a push through, not a swing, and a locked ankle is what wins it.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
