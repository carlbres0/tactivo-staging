 "narration": [
  {
   "t": 0,
   "text": "Football drags everybody towards the ball, and the far winger goes cold. Use that.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "A goal in each wide channel, and you can only score where you outnumber them.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 5,
   "text": "Overload the near channel on purpose and draw the defenders across.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 12.5,
   "text": "Then switch within two passes, because the far channel is standing empty.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 17.86,
   "text": "Once that's landing, switches must skip a line. One clipped ball, no relay.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 20.36,
   "text": "Draw them in before you play away. A switch from a standing start switches nothing.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
