  {
   "t": 0,
   "text": "No goals, no gates, just two teams and a ball nobody holds.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 1,
   "text": "More than three touches and it burns, so possession flips there and then.",
   "hold": 2.5,
