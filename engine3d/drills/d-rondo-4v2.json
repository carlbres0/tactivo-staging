 "narration": [
  {
   "t": 0,
   "text": "Need six players busy in one small square? The rondo still does it best.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Four on the outside of a twelve metre grid, two chasing in the middle.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 5.65,
   "text": "Quick passes round the square drag the two defenders side to side.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 16.15,
   "text": "A gap opens between them, so thread it through and that's a point.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 20.19,
   "text": "Ten passes scores too. Later, everyone shifts one cone clockwise after each pass.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 22.69,
   "text": "The angle beats the pass, so receivers give the passer two options, never one.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
