  {
   "t": 0,
   "text": "Feet and hips first, ball later. The line is a habit before it's a contest.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 3.25,
   "text": "No ball to start. You jog and cut, they shadow defend two arm's lengths away.",
   "hold": 2.5,
   "beat": "take"
  },
  {
   "t": 8,
   "text": "Stay between you and the cone castle behind them, always on the line.",
   "hold": 2.5,
   "beat": "take"
  },
  {
