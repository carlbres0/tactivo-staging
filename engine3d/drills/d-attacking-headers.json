 "narration": [
  {
   "t": 0,
   "text": "Hand serves from the byline, and a header down at goal. That's the whole drill.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "The attacker holds the penalty spot. The server waits on the byline, ball in hand.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 2.61,
   "text": "The serve loops in. Attack it at its highest point, never wait underneath it.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 4.78,
   "text": "Forehead through the top half, eyes open, neck braced, and head it down across goal.",
   "hold": 2.5,
   "beat": "action"
  },
  {
