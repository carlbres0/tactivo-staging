 "narration": [
  {
   "t": 0,
   "text": "Want them practising between sessions? Send them home with one thing to go and do.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Jog a lap, then gather in and stretch through the main muscle groups.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 4.08,
   "text": "While they're stretching, set one challenge for the week. Fifty juggles, or ten minutes of wall passes.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 8.67,
   "text": "Or one take-on a game. Then get two players to repeat it back to you.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 10.2,
   "text": "Finish by naming what the group did well tonight.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 12.7,
   "text": "A challenge they can do alone in a garden is the one that actually gets done.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
