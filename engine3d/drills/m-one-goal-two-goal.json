  {
   "t": 0,
   "text": "Six attackers against five and a keeper, in waves that never stop.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "One full goal, and two counter gates for the defenders to break out through.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 4.54,
   "text": "The moment one attack ends, the next ball's already coming in.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 14.07,
   "text": "Defenders win the wave by clearing beyond halfway, or countering through a gate.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 22.69,
   "text": "Swap the units halfway. Later on, let attackers recycle a cleared ball.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
