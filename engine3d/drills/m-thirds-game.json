  {
   "t": 0,
   "text": "Tired of watching them hoof it from back to front? Fix it here.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "The pitch is split into three zones, back to front.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 3.33,
   "text": "A goal only counts if the ball was received in the middle third first.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 9.33,
   "text": "Players move wherever they like. It's only the ball's path that's restricted.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 13.33,
   "text": "Then ask for two players to touch it in the middle, not one.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
