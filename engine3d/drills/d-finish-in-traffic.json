  {
   "t": 0,
   "text": "Real goals get scored in a mess, not with a clean picture in front of you.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Three attackers against two defenders and a keeper, breaking from the halfway line.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 6.78,
   "text": "The shot goes through traffic, and the keeper can only spill it.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 16.72,
   "text": "Rebounds are live, so they follow every shot in until the ball is dead.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 22.6,
   "text": "Once they're sharp, add a defender recovering from behind the play.",
