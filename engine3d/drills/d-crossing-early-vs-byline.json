 "narration": [
  {
   "t": 0,
   "text": "Most bad crosses are good crosses at the wrong moment. Coach the look, not the technique.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Half a pitch, both channels marked, a wide player with a defender to beat.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 5.39,
   "text": "Runners arrive centrally. The wide player has to look up before deciding anything.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 9.62,
   "text": "Ahead of the defence already, cross early. If not, take it to the byline.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 12.83,
   "text": "Ten deliveries a side. Vary the runners' timing so the picture changes every repetition.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 15.33,
   "text": "The runners dictate the cross, not the space, and looking up is the whole skill.",
