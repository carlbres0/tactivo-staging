 "narration": [
  {
   "t": 0,
   "text": "Fancy a game where the keeper has to play out every single time?",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "A normal game, but every restart begins with the keeper playing short.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 2.3,
   "text": "No long kicks. A long clearance hands possession to the other keeper.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 7.57,
   "text": "The keeper counts as an outfield player whenever their team has the ball.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 16.46,
   "text": "Once they're settled, keepers must complete two passes before the ball crosses halfway.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 18.96,
   "text": "Keepers get almost no game time with their feet. This fixes it inside the session.",
   "hold": 2.5,
   "beat": "why"
  }
