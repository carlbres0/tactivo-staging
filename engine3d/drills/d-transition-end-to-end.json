 "narration": [
  {
   "t": 0,
   "text": "The ball's never dead in this one, so nobody gets a breather.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "A normal game, but you serve a new ball the instant possession changes.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 3.17,
   "text": "No stoppages at all. The picture flips, and they have to read it.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 10.3,
   "text": "Win it in your own third and you're attacking, with the runner already going.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 15.85,
   "text": "Once they're reading it, serve the new ball behind the defending line.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 18.35,
   "text": "It's exhausting by design. Three-minute bursts, or the quality falls off a cliff.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
