 "narration": [
  {
   "t": 0,
   "text": "A counter-press gets played through when nobody stayed home. This decides who stays.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "A forty five by thirty five area with a full goal and two counter gates.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 4.94,
   "text": "While you attack, two nominated players are rest defence and stay behind the ball.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 11.01,
   "text": "When it's lost, they delay and screen the gates while the press engages ahead.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 14.12,
   "text": "Freeze play three times to check who was where. Then nominate only one.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 16.62,
   "text": "Counter-pressing only works if somebody stayed home, and the attacking shape decides that.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
