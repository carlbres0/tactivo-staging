 "narration": [
  {
   "t": 0,
   "text": "Nobody can tackle your wide players in this one, so the switch always pays.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Two goals, wide zones down each side, and both zones must see the ball.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 3.02,
   "text": "Central players circulate, then feed the first wide zone, where nobody can tackle.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 12.53,
   "text": "Back inside, and only a central player can loft the switch to the far zone.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 23.2,
   "text": "Once they look up on their own, let one defender into each wide zone.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 25.7,
   "text": "Protecting them first builds the habit. Take the protection away once it's there.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
