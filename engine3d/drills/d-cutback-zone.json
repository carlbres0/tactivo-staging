 "narration": [
  {
   "t": 0,
   "text": "Cut-backs beat crosses at every age below sixteen, and this rule forces them.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "A thirty five by thirty area with a goal and cut-back zones marked by the byline.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 4.82,
   "text": "Six against six, but goals only count from a ball cut back inside the zone.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 7.83,
   "text": "So the wide player carries past the defender and reaches the zone first. No early crosses.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 12.04,
   "text": "Runners cover near post, the spot and the edge. Make the cut-back first time.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 14.54,
   "text": "The ball arrives at a running foot instead of a jumping head, so they score more.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
