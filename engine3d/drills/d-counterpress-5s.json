 "narration": [
  {
   "t": 0,
   "text": "Five seconds to win it back. That single rule changes how they react to losing it.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "A thirty by twenty five area, two even teams, and you counting out loud.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 2.93,
   "text": "The clock starts the second the ball is lost. Nearest player presses it.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 13.54,
   "text": "The next two cut the passing lanes. A regain inside the window scores a point.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 18.3,
   "text": "If five seconds pass, drop behind the ball in two banks, ten metres apart.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 20.8,
   "text": "The moment of loss is the best moment to win it back. Their heads are down.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
