 "narration": [
  {
   "t": 0,
   "text": "Some games run themselves once you have set them up. This is one.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Four corner nests, four teams, and every ball piled in the middle.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 5.1,
   "text": "Dribble one ball at a time back to your own nest. Never carry it.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 17.86,
   "text": "Once the middle is empty, start stealing from anybody else's nest.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 21.26,
   "text": "Let one player per team guard the nest, so a robber has to beat somebody.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 23.76,
   "text": "Ninety seconds a round, counted out, and nobody stops moving for a second.",
