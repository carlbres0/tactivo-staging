 "narration": [
  {
   "t": 0,
   "text": "Keeper wants to train alone, with nobody to serve? A wall does it.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Gloves on, a rebound board, and marks at four and six metres to ladder back.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 10.52,
   "text": "Throw against the wall and catch the return, thumbs together behind the ball, up at the chest.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 23.97,
   "text": "Then kick-serve rounds, gathering the rebound at the feet, and reaction catches at full stretch.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 29.23,
   "text": "Once that's easy, face away, turn on your own call, and find the ball.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 31.73,
   "text": "A keeper with a wall never has to wait for a server again.",
   "hold": 2.5,
   "beat": "why"
  }
