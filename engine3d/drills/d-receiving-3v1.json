  {
   "t": 0,
   "text": "Three on the outside, one defender in the middle, and a twelve metre grid.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "The ball has to go through the middle player once every three passes.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 3.93,
   "text": "Someone checks in to receive, body half turned, so the first touch goes either way.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 9.42,
   "text": "Turn and play forward off that touch, before the defender gets there.",
   "hold": 2.5,
   "beat": "action"
  },
  {
