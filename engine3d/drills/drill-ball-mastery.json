 "narration": [
  {
   "t": 0,
   "text": "Need something for the first five minutes while players are still arriving?",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Every player with a ball, and no cones to put out at all.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 2.34,
   "text": "Toe taps first, alternate feet on top of the ball, eyes up not down.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 12.46,
   "text": "Then inside outside touches across the body, and sole rolls side to side.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 15.58,
   "text": "Once the touch settles, start slow and build the speed up round by round.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 18.08,
   "text": "It's the easiest way to get everyone touching a ball before the session starts.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
