  {
   "t": 0,
   "text": "It's the back pass under pressure that costs keepers goals, not the shots.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Back passes arrive at varying pace and angle, with a forward pressing every time.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 2.46,
   "text": "The first touch opens the body. Never control it straight in front of goal.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 10.47,
   "text": "Play out through a wide gate, or clear long down the channel if the press is on.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 12.32,
   "text": "Once they're calm, send the back passes in bouncing and under hit.",
   "hold": 2.5,
   "beat": "progression"
  },
