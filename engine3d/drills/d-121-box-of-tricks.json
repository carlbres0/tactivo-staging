 "narration": [
  {
   "t": 0,
   "text": "How many touches fit inside a box two metres wide, in thirty seconds?",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "One tiny square, one ball, and your watch. That's the whole thing.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 3.21,
   "text": "Soles, insides, both feet, as many touches as they can without leaving the box.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 10.44,
   "text": "Count out loud in tens. Three rounds of free touches, toe-taps, then sole rolls.",
