 "narration": [
  {
   "t": 0,
   "text": "Crowding gets their heads up better than anything you can shout from the side.",
   "hold": 2.5,
   "beat": "hook"
  },
  {
   "t": 0,
   "text": "Everyone dribbles at once in a square that's far too small for the group.",
   "hold": 2.5,
   "beat": "picture"
  },
  {
   "t": 4.76,
   "text": "Two rules only. No bumping into anybody, and no balls out of the area.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 12.7,
   "text": "On your call they all turn together, and the box shrinks by two metres.",
   "hold": 2.5,
   "beat": "action"
  },
  {
   "t": 15.88,
   "text": "Once they're managing, send two players in without a ball to be obstacles.",
   "hold": 2.5,
   "beat": "progression"
  },
  {
   "t": 18.38,
   "text": "The tight space punishes anyone who doesn't look up, and they work it out themselves.",
   "hold": 2.5,
   "beat": "why"
  }
 ]
